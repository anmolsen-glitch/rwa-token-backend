NODE_ENV=development
PORT=4100

# Same database as rwa-token-backend — this is what makes the strangler work.
# Supabase: use the TRANSACTION POOLER (port 6543). Direct 5432 connections are
# IPv6-only on new projects. Copy this value from ../rwa-token-backend/.env.
# Runtime connection: LEAST PRIVILEGE. app_tenant_login is not a table owner and
# has no BYPASSRLS, so migration 042's policies actually constrain it.
DATABASE_URL=postgresql://app_tenant_login.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Cross-tenant connection for background workers + pre-tenant auth lookups.
DATABASE_WORKER_URL=postgresql://app_worker_login.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Owner connection, used ONLY by `npm run db:migrate` and `db:setup-roles`.
# The running app must never use this.
DATABASE_ADMIN_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

DATABASE_SSL=no-verify
DATABASE_POOL_MAX=5

# MUST match rwa-token-backend exactly, or sessions break mid-migration.
JWT_SECRET=dev-only-insecure-secret-change-me-to-32-chars-plus
JWT_EXPIRES_IN=12h
INVESTOR_JWT_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Unmigrated routes proxy here. Unset once every module has landed.
LEGACY_API_URL=http://localhost:4000

LOG_LEVEL=debug

# Platform infra addresses (IdFactory, ClaimIssuer, TREXFactory).
ADDRESSES_FILE=./config/deployed-addresses.json
