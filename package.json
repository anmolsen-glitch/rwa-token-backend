{
  "name": "rwa-token-backend-nest",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for the ERC-3643 RWA token platform (strangler rewrite of rwa-token-backend)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:setup-roles": "tsx src/shared/db/setup-roles.ts",
    "chain:rotate-claim-key": "tsx src/shared/chain/rotate-claim-key.ts",
    "db:migrate-documents": "tsx src/shared/storage/migrate-documents.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1114.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/http-proxy": "^10.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.4",
    "ethers": "^6.17.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.3.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
